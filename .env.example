# Local Engine Configurations
OLLAMA_HOST=http://127.0.0.1:11434
VLLM_BASE_URL=http://localhost:8000/v1

# Cloud API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...
DEEPSEEK_API_KEY=sk-...

# Agent Defaults
AGENT_APPROVAL=ask
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=1024
AGENT_TEMPERATURE=0.2
AGENT_TOP_P=0.9